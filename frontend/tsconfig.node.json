{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node"],
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "./node_modules/.tsc-node-out"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "postcss.config.js"]
}
