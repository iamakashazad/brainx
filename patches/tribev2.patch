+                elapsed = _time.monotonic() - started
+                # A negative returncode means the child was killed by a signal
+                # rather than exiting on its own. That is not the cold-start
+                # flake this retry loop exists for, and retrying it multiplies an
+                # already-expensive failure across three nested retry layers, so
+                # fail fast and let the real reason surface.
+                if result.returncode < 0:
