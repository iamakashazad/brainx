+            # BrainX's tribe_loader sets HOME=model_cache (and XDG_CACHE_HOME) so
+            # torch/HF caches stay inside the workspace. That must NOT leak into
+            # uvx: with HOME=model_cache, uv cannot see its managed interpreters
+            # under ~/.local/share/uv/python and silently falls back to the Xcode
+            # CommandLineTools python3 (3.9.6). whisperx then has to build several
+            # sdists from source, which takes tens of minutes, holds the uv cache
+            # lock, and dies under memory pressure — observed as returncode=-15
+            # with an empty stderr. Restore the real HOME (read from the password
+            # database so the clobbered env cannot fool us) so uv resolves its
+            # managed 3.11 and warm wheel cache. HF_HOME is inherited unchanged,
+            # so whisperx model downloads still land in model_cache.
+            import pwd as _pwd
+
+            env["HOME"] = _pwd.getpwuid(os.getuid()).pw_dir
+            env.pop("XDG_CACHE_HOME", None)
+
+            # uvx whisperx occasionally dies on a cold invocation with an
+            # empty stderr (observed while uv refreshes the tool env after
+            # OS/toolchain updates). Retry before failing the whole pipeline.
+            import time as _time
+
+            # A cold start (uv resolve + wheel download) legitimately takes a
+            # couple of minutes; past this it is a hang, not slow progress.
+            timeout_seconds = int(os.environ.get("BRAINX_WHISPERX_TIMEOUT", "900"))
+
+            result = None
