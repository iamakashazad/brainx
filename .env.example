DEVICE=cpu
MODEL_CACHE_PATH=./model_cache
DATABASE_URL=sqlite+aiosqlite:///./brainx.db

# Required. Without it, every analysis submission is rejected with a 422
# ("DEEPSEEK_API_KEY is not configured") — text simulation and the
# recommendations engine both call DeepSeek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Required for image content (ui_screens / static uploads) when
# VISION_PROVIDER=replicate. Text-only analyses work without it.
REPLICATE_API_TOKEN=
VISION_PROVIDER=replicate

# Required. Used to download TRIBEv2 model weights from HuggingFace at startup.
HF_TOKEN=

# Per-job hard timeout enforced by the queue worker (seconds).
# CPU inference is slow — expect multi-minute runs; default is 1 hour.
JOB_TIMEOUT_SECONDS=3600
